{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,var/**,scripts/seed_dev.py,scripts/export_openapi.py,Dockerfile,.env,.env.*,*.md}"
    }
  },
  "crons": [
    { "path": "/v1/internal/cron/daily", "schedule": "0 5 * * *" },
    { "path": "/v1/internal/cron/sweep", "schedule": "0 17 * * *" }
  ]
}
