# WealthPilot API settings (all prefixed WP_). Copy to services/api/.env for local development.
# Never commit real secrets. On Vercel, set these in Project Settings > Environment Variables instead
# (see README "Deploying to Vercel"); the .env file is not deployed.

# development | test | staging | production. On Vercel it defaults to production (VERCEL_ENV=production) or
# staging (preview deployments).
WP_ENV=development
WP_LOG_LEVEL=INFO
# postgres:// and postgresql:// URLs are accepted (rewritten to postgresql+psycopg://). When unset, the API uses
# DATABASE_URL, then POSTGRES_URL (both injected by the Neon integration on Vercel; pooled).
WP_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/wealthpilot
# Direct (unpooled) URL for Alembic. When unset: DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING, then the URL above.
WP_MIGRATION_DATABASE_URL=
# In-process connection pool size; 0 = no pool (NullPool, the default on Vercel where PgBouncer pools).
WP_DB_POOL_SIZE=5

# --- Auth -------------------------------------------------------------------------------------------------
# oidc: verify bearer JWTs against the provider's JWKS. dev: also accept "Bearer dev:<subject>:<email>"
# (refused at startup when WP_ENV=production and on every Vercel production/preview deployment).
WP_AUTH_MODE=dev
# Clerk: the Frontend API URL exactly as it appears in the token's iss (no trailing slash), e.g.
# https://clerk.example.com or https://your-app-12.clerk.accounts.dev
WP_OIDC_ISSUER=
# Clerk: <Frontend API URL>/.well-known/jwks.json
WP_OIDC_JWKS_URL=
WP_OIDC_AUDIENCE=                  # optional; aud is checked only when set (Clerk session tokens have no aud)
# Optional comma-separated allowed azp values (Clerk: the web app origin(s), e.g. https://app.example.com).
# Checked only when set and the token carries azp (tokens from the native app may not).
WP_OIDC_AUTHORIZED_PARTIES=
WP_JWKS_CACHE_SECONDS=3600
WP_JWT_LEEWAY_SECONDS=30

# Signs short-lived export download links. Required (not the default) in production and on Vercel deployments.
WP_SECRET_KEY=dev-insecure-secret-change-me
WP_DOWNLOAD_TOKEN_TTL_SECONDS=900

# Comma-separated browser origins allowed by CORS (the mobile app does not need CORS).
WP_CORS_ORIGINS=http://localhost:8081,http://localhost:3000
# Optional regex for more origins, e.g. the web app's Vercel preview URLs:
# WP_CORS_ORIGIN_REGEX=https://wealthpilot-web-[a-z0-9-]+-your-team\.vercel\.app
WP_CORS_ORIGIN_REGEX=

# --- Jobs -------------------------------------------------------------------------------------------------
# 1 = run scenario/export jobs inside the request (dev/tests; default on Vercel). 0 = leave them for
# `python -m wealthpilot_api.worker`.
WP_INLINE_JOBS=1
# Cron secret for /v1/internal/cron/{daily,sweep} (requests must send "Authorization: Bearer <secret>"); without
# it those endpoints always answer 401. On Vercel set CRON_SECRET instead (Vercel Cron sends it automatically);
# the API reads CRON_SECRET from the environment when this is unset.
WP_CRON_SECRET=
WP_WORKER_POLL_SECONDS=2
WP_JOB_MAX_ATTEMPTS=5

# --- Exports ----------------------------------------------------------------------------------------------
WP_STORAGE_BACKEND=local           # local | s3 | postgres (default on Vercel: no persistent disk there)
WP_EXPORT_DIR=var/exports
WP_EXPORT_TTL_HOURS=24
WP_S3_BUCKET=
WP_S3_PREFIX=exports/
WP_S3_REGION=
WP_S3_ENDPOINT_URL=

# --- Market data ------------------------------------------------------------------------------------------
# Free ECB-based reference rates, shown as suggestions only (never used unless the user saves them).
WP_FX_REFERENCE_URL=https://api.frankfurter.app
WP_FX_REFERENCE_CACHE_HOURS=24
WP_FX_REFERENCE_TIMEOUT_SECONDS=5

# --- Billing ----------------------------------------------------------------------------------------------
# Shared secret configured as the Authorization header value of the RevenueCat webhook.
WP_REVENUECAT_WEBHOOK_SECRET=

# --- Notifications ----------------------------------------------------------------------------------------
WP_EXPO_PUSH_ENABLED=0             # 0 = no-op sender (in-app inbox only)
WP_EXPO_ACCESS_TOKEN=
WP_EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# --- Privacy ----------------------------------------------------------------------------------------------
WP_ERASURE_DELAY_DAYS=30
