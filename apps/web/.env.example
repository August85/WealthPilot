# Copy to apps/web/.env.local for local development. On Vercel set these in Project → Settings → Environment
# Variables. NEXT_PUBLIC_* values are inlined into the browser bundle at build time: never put secrets in them.

# WealthPilot API base URL including the /v1 prefix (e.g. https://<api>.vercel.app/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# Clerk (Google, Apple, Microsoft, email code and passkeys are enabled in the Clerk dashboard).
# When the publishable key is set, Clerk sign-in is used and app routes are protected by src/proxy.ts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-side only (never NEXT_PUBLIC_). Required at runtime whenever the publishable key is set.
CLERK_SECRET_KEY=
# Optional Clerk JWT template name if the API expects a custom template; empty = default session token.
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Local development only: with NO Clerk publishable key and this set to 1, the app shows a clearly labelled
# "Dev sign-in" that sends `dev:<subject>:<email>` bearer tokens (kept in sessionStorage). The API must run with
# WP_AUTH_MODE=dev. Never set this in production.
NEXT_PUBLIC_DEV_AUTH=1
