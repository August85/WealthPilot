# Copy to apps/mobile/.env (or .env.local) and fill in. Only EXPO_PUBLIC_* values reach the app bundle;
# never put secrets here. Restart `expo start` after changing them.

# API base URL including the /v1 prefix. On a physical device use your machine's LAN IP, not localhost.
# Android emulator: http://10.0.2.2:8000/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/v1

# Clerk publishable key (pk_test_... / pk_live_...). When set, Clerk sign-in is used.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional Clerk JWT template name if the API expects a custom template; empty = default session token.
EXPO_PUBLIC_CLERK_JWT_TEMPLATE=

# Passkeys need a development build (not Expo Go) with @clerk/expo-passkeys. 1 = enable.
EXPO_PUBLIC_CLERK_PASSKEYS=0

# Local development only: with no Clerk key and this set to 1, the app shows a labelled "Dev sign-in"
# that sends `dev:<subject>:<email>` bearer tokens. The API must also run with dev auth enabled.
EXPO_PUBLIC_DEV_AUTH=1

# EAS project ID (needed for Expo push tokens). Also set by `eas init` in app config.
EXPO_PUBLIC_EAS_PROJECT_ID=

# RevenueCat public SDK keys. Purchasing stays "coming soon" until store products exist.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
